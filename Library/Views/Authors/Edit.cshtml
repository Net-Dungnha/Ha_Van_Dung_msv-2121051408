@model DemoMVC.Models.Entity.Author

@{
    ViewData["Title"] = "Chỉnh sửa Tác giả";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-white py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa Tác giả</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="TenTacGia" class="form-label fw-bold">Tên tác giả <span class="text-danger">*</span></label>
                        <input asp-for="TenTacGia" class="form-control" />
                        <span asp-validation-for="TenTacGia" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="NamSinh" class="form-label fw-bold">Năm sinh</label>
                            <input asp-for="NamSinh" type="number" class="form-control" />
                            <span asp-validation-for="NamSinh" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="QuocTich" class="form-label fw-bold">Quốc tịch</label>
                            <input asp-for="QuocTich" class="form-control" />
                            <span asp-validation-for="QuocTich" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Mota" class="form-label fw-bold">Mô tả tác giả</label>
                        <textarea asp-for="Mota" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Mota" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-short"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning text-white px-4">
                            <i class="bi bi-save"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
