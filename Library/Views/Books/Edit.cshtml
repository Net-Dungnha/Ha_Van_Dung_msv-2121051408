@model DemoMVC.Models.Entity.Book

@{
    ViewData["Title"] = "Chỉnh sửa Sách";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-white py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa Sách</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="TenSach" class="form-label fw-bold">Tên sách <span class="text-danger">*</span></label>
                        <input asp-for="TenSach" class="form-control" />
                        <span asp-validation-for="TenSach" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ISBN" class="form-label fw-bold">ISBN</label>
                            <input asp-for="ISBN" class="form-control" />
                            <span asp-validation-for="ISBN" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NhaXuatBan" class="form-label fw-bold">Nhà xuất bản</label>
                            <input asp-for="NhaXuatBan" class="form-control" />
                            <span asp-validation-for="NhaXuatBan" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AuthorId" class="form-label fw-bold">Tác giả <span class="text-danger">*</span></label>
                            <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId">
                                <option value="">-- Chọn tác giả --</option>
                            </select>
                            <span asp-validation-for="AuthorId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoriesId" class="form-label fw-bold">Thể loại <span class="text-danger">*</span></label>
                            <select asp-for="CategoriesId" class="form-select" asp-items="ViewBag.CategoriesId">
                                <option value="">-- Chọn thể loại --</option>
                            </select>
                            <span asp-validation-for="CategoriesId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="NamXuatBan" class="form-label fw-bold">Năm xuất bản</label>
                            <input asp-for="NamXuatBan" type="number" class="form-control" />
                            <span asp-validation-for="NamXuatBan" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Mota" class="form-label fw-bold">Mô tả sách</label>
                        <textarea asp-for="Mota" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Mota" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-short"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning text-white px-4">
                            <i class="bi bi-save"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
