@model IEnumerable<DemoMVC.Models.Entity.Book>

@{
    ViewData["Title"] = "Danh sách Sách";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary"><i class="bi bi-book-half"></i> Quản lý Sách</h1>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle"></i> Thêm Sách mới
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo tên sách, ISBN, tên tác giả hoặc thể loại..." />
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Tên sách</th>
                        <th>ISBN</th>
                        <th>Tác giả</th>
                        <th>Thể loại</th>
                        <th>Năm XB</th>
                        <th>Nhà xuất bản</th>
                        <th class="text-center" style="width: 250px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Id</strong></td>
                                <td><span class="text-secondary fw-semibold">@item.TenSach</span></td>
                                <td><code class="text-dark">@item.ISBN</code></td>
                                <td>@(item.Author != null ? item.Author.TenTacGia : "N/A")</td>
                                <td>
                                    <span class="badge bg-secondary">@(item.Categories != null ? item.Categories.TenTheLoai : "N/A")</span>
                                </td>
                                <td>@item.NamXuatBan</td>
                                <td>@item.NhaXuatBan</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy sách nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
