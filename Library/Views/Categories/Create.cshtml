@model DemoMVC.Models.Entity.Categories

@{
    ViewData["Title"] = "Thêm Thể loại mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0"><i class="bi bi-tag-fill"></i> Thêm Thể loại mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TenTheLoai" class="form-label fw-bold">Tên thể loại <span class="text-danger">*</span></label>
                        <input asp-for="TenTheLoai" class="form-control" placeholder="Nhập tên thể loại sách" />
                        <span asp-validation-for="TenTheLoai" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Mota" class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea asp-for="Mota" rows="4" class="form-control" placeholder="Tóm tắt về thể loại này..."></textarea>
                        <span asp-validation-for="Mota" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-short"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-save"></i> Lưu thể loại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
