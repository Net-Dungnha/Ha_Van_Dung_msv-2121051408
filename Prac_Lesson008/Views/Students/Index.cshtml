@model IEnumerable<Prac_Lesson008.ViewModels.StudentCourseViewModel>

@{
    ViewData["Title"] = "Danh sách Sinh viên";
}

<h1>Danh sách Sinh viên</h1>

<!-- Form tìm kiếm: Sử dụng LINQ Where() để lọc dữ liệu -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Tìm theo tên:</label>
            <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Nhập tên sinh viên..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Lọc theo khóa học:</label>
            <select name="courseId" class="form-control">
                <option value="">-- Tất cả --</option>
                @if (ViewBag.Courses != null)
                {
                    @foreach (var item in (SelectList)ViewBag.Courses)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-secondary">Xóa bộ lọc</a>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create">Thêm mới</a>
</p>

<!-- Bảng hiển thị dữ liệu từ ViewModel (kết hợp Student + Course) -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Tên Sinh viên</th>
            <th>Tuổi</th>
            <th>Lớp</th>
            <th>Khóa học</th>
            <th>Mô tả khóa học</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.StudentName</td>
            <td>@item.Age</td>
            <td>@item.ClassName</td>
            <td>@item.CourseName</td>
            <td>@item.CourseDescription</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StudentId">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.StudentId">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.StudentId">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>

<p><strong>Tổng số sinh viên:</strong> @Model.Count()</p>
