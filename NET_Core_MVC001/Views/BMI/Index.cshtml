@model Stu_MVC_P.Models.BMI

@{
    ViewData["Title"] = "BMI Calculator";
}

<h2>BMI Calculator</h2>

<form asp-action="Index" asp-controller="BIM" method="post">
    <div class="form-group">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Height">Height (meters)</label>
        <input asp-for="Height" class="form-control" type="number" step="0.01" />
    </div>
    <div class="form-group">
        <label asp-for="Weight">Weight (kg)</label>
        <input asp-for="Weight" class="form-control" type="number" step="0.1" />
    </div>
    <button type="submit" class="btn btn-primary">Calculate BMI</button>
</form>

@if (Model?.BMI != null)
{
    <div class="mt-3">
        <h4>Result for @Model.Name</h4>
        <p><strong>BMI:</strong> @Model.BMI.Value.ToString("F2")</p>
        <p><strong>Category:</strong> @Model.Result</p>
    </div>
}